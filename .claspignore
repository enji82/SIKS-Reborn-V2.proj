# =========================================================================
# 2. CLASP IGNORE CONFIGURATION
# Fungsi: Mencegah file lokal non-GAS ikut terunggah ke Google Skrip Cloud
# =========================================================================

# Blokir format file yang tidak didukung Google Apps Script
**/*.md
**/*.json
**/*.js.map
**/node_modules/**
README.md

# Pengecualian wajib (Harus diunggah ke GAS)
!appsscript.json

# Perbaikan Typo: Blokir folder internal AI Antigravity agar tidak diunggah
.agents/**
.cursor/**
.vscode/**
.github/**
.continue/**
ai-agent/**
.agent/**

# Blokir file konfigurasi lokal Clasp & Git
.clasp.json
.gitignore
.cursorignore
.cursorrules

# Dev-only: Bukan berkas Apps Script (Bisa memicu error sync GAS)
validate_combined.js
all_scripts.js
scratch/
**/*.py
fix_frontend.py
fix_notif.py
refactor_sultan.py
mutasi_paud_update.py
scratch_replace_rombel.py
.DS_Store
check_oktober.js
getDetail.js
architectural_blueprint.md
check_sheet.js
