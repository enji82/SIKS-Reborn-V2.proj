# =========================================================================
# CLASP IGNORE CONFIGURATION
# Fungsi: Mencegah file lokal non-GAS ikut terunggah ke Google Skrip Cloud
# =========================================================================

# Blokir format file yang tidak didukung Google Apps Script
**/*.md
**/*.json
**/*.js.map
**/*.pdf
**/*.csv
**/*.txt
**/*.py
**/*.sh
**/*.command
**/*.js
**/node_modules/**
README.md

# Pengecualian wajib (Harus diunggah ke GAS)
!appsscript.json

# Blokir folder internal IDE & scratch
.agents/**
.cursor/**
.vscode/**
.github/**
.continue/**
ai-agent/**
.agent/**
scratch/**
templates_sultan/**

# Blokir file konfigurasi lokal Clasp & Git
.clasp.json
.gitignore
.cursorignore
.cursorrules
.DS_Store
